# Google Drive sign-in (server side). Needed for `npm run dev`, `npm start`
# and on Netlify (set them in the site's environment variables instead).
# See README → Google Drive sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=
# Public address, only needed if the server cannot tell it from the request.
# PUBLIC_URL=https://plans.example.com

# Shown on /privacy and /terms, which Google's consent screen links to.
# The contact email is needed before publishing the Google app.
VITE_CONTACT_EMAIL=
# VITE_OPERATOR_NAME=Your name or company

# Optional, for static hosting with no server: a client ID used in the browser
# (users then sign in again about once an hour).
# VITE_GOOGLE_CLIENT_ID=

# Optional: Dropbox sync. The key of a Dropbox app with "App folder" access
# whose redirect URIs include https://<your-domain>/ (and http://localhost:5173/
# for development). No secret or server is needed. See README → Dropbox sync.
# VITE_DROPBOX_APP_KEY=
