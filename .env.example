# Google Drive sign-in (server side). Needed for `npm run dev`, `npm start`
# and on Netlify (set them in the site's environment variables instead).
# See README → Google Drive sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=
# Public address, only needed if the server cannot tell it from the request.
# PUBLIC_URL=https://plans.example.com

# Optional, for static hosting with no server: a client ID used in the browser
# (users then sign in again about once an hour).
# VITE_GOOGLE_CLIENT_ID=
